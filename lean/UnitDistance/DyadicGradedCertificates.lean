theorem gradedKernel_6 : ∀ left v, v ∈ stage 6 →
    ((∀ k, sidedStep left k v ∈ stage 8) ↔ v ∈ stage 7) := by
  apply gradedKernel_of_certificate 6 b6 b8 pivots8
    stage_6_eq stage_8_eq pivots8_correct
    (d := 3) ?_ minorMasks6 minorPivots6 minor6_correct
  rw [finrank_stage_6, finrank_stage_7]

theorem gradedKernel_below_seven (n : ℕ) (hn : n < 7) (left : Bool)
    (v : V) (hv : v ∈ stage n) :
    (∀ k, sidedStep left k v ∈ stage (n + 2)) ↔ v ∈ stage (n + 1) := by
  interval_cases n
  · exact gradedKernel_0 left v hv
  · exact gradedKernel_1 left v hv
  · exact gradedKernel_2 left v hv
  · exact gradedKernel_3 left v hv
  · exact gradedKernel_4 left v hv
  · exact gradedKernel_5 left v hv
  · exact gradedKernel_6 left v hv

end UnitDistance.Dyadic.Graded
