module

public import UnitDistance.DyadicGradedMaps

@[expose] public section
set_option backward.privateInPublic true


/-! Kernel-checked identity minors for both orientations of the actual
dyadic graded multiplication map. Generated by the named Python script;
the mathematical trust base is the generic soundness proof and Lean kernel. -/

set_option maxRecDepth 100000
set_option maxHeartbeats 8000000

namespace UnitDistance.Dyadic.Graded
open Filtration

theorem finrank_stage_zero : Module.finrank F (stage 0) = 32 := by
  rw [← AlgebraD.finrank_augmentationPower_eq]
  exact AlgebraD.finrank_augmentationPower_zero

def minorMasks0 (left : Bool) : Fin 1 → ℕ :=
  if left then ![1] else ![1]
def minorPivots0 : Fin 1 → Fin 3 × Fin 32 := ![(0, 15)]

theorem minor0_correct : ∀ left i j,
    joint left b2 pivots2 (combination b0 (minorMasks0 left i))
      (minorPivots0 j) = if i = j then 1 else 0 := by decide +kernel

theorem gradedKernel_0 : ∀ left v, v ∈ stage 0 →
    ((∀ k, sidedStep left k v ∈ stage 2) ↔ v ∈ stage 1) := by
  apply gradedKernel_of_certificate 0 b0 b2 pivots2
    stage_zero_eq stage_2_eq pivots2_correct
    (d := 1) ?_ minorMasks0 minorPivots0 minor0_correct
  rw [finrank_stage_zero, finrank_stage_1]

def minorMasks1 (left : Bool) : Fin 3 → ℕ :=
  if left then ![257, 5, 261] else ![257, 5, 261]
def minorPivots1 : Fin 3 → Fin 3 × Fin 32 := ![(0, 7), (0, 13), (1, 7)]

theorem minor1_correct : ∀ left i j,
    joint left b3 pivots3 (combination b1 (minorMasks1 left i))
