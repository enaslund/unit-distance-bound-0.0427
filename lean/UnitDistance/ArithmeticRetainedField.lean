module

public import UnitDistance.ArithmeticRetainedSquareclasses
public import UnitDistance.GeneratedQuadraticTower

@[expose] public section
set_option backward.privateInPublic true


/-!
# The actual full retained quadratic field

This constructs the field generated by the twelve specified catalog
squareclasses over the actual genus field. Its relative and absolute degrees
and its actual Galois property are derived from proved nonsquareness and
invariance. No arithmetic tower or ramification claim is part of this file.
-/

noncomputable section
set_option maxRecDepth 100000
set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 200000
set_option backward.isDefEq.respectTransparency false
namespace UnitDistance.ArithmeticRetained
open ArithmeticChosenGenus Multiquadratic

/-- The actual iterated quadratic construction of the twelve-radical field. -/
def fullRetainedTower : GeneratedGaloisTower ℚ retainedRadicand Finset.univ :=
  Classical.choice (exists_generatedGaloisTower ℚ retainedRadicand
    retainedRadicand_ne_zero retained_products_not_isSquare
    retainedRadicand_invariant Finset.univ)

/-- The actual full retained quadratic field. -/
abbrev RetainedField := fullRetainedTower.Carrier

instance retainedField_field : Field RetainedField := fullRetainedTower.field
instance retainedField_charZero : CharZero RetainedField := fullRetainedTower.charZero
instance retainedField_algebraGenus : Algebra GenusField RetainedField := fullRetainedTower.algebra
instance retainedField_algebraRat : Algebra ℚ RetainedField := DivisionRing.toRatAlgebra

theorem retainedTower_baseAlgebra_eq : fullRetainedTower.baseAlgebra = retainedField_algebraRat :=
  Subsingleton.elim _ _
instance retainedField_scalarTower : IsScalarTower ℚ GenusField RetainedField := by
  rw [← retainedTower_baseAlgebra_eq]
  exact fullRetainedTower.scalarTower
instance retainedField_finiteGenus : Module.Finite GenusField RetainedField := fullRetainedTower.finite
instance retainedField_galoisRat : IsGalois ℚ RetainedField := by
  rw [← retainedTower_baseAlgebra_eq]
  exact fullRetainedTower.baseGalois

instance retainedField_numberField : NumberField RetainedField where
  to_finiteDimensional := Module.Finite.trans GenusField RetainedField

/-- The relative degree follows from the twelve genuinely independent
actual genus-field squareclasses. -/
theorem retainedField_relative_degree : Module.finrank GenusField RetainedField = 4096 := by
  simpa using fullRetainedTower.degree

/-- The actual full retained field has absolute degree 2^19. -/
theorem retainedField_degree : Module.finrank ℚ RetainedField = 524288 := by
  rw [← Module.finrank_mul_finrank ℚ GenusField RetainedField,
    genusField_degree,retainedField_relative_degree]

/-- The actual Galois group has the proved field degree. -/
theorem retainedField_galoisGroup_card : Nat.card (Gal(RetainedField/ℚ)) = 524288 := by
  rw [IsGalois.card_aut_eq_finrank,retainedField_degree]

/-- The constructed field contains an actual square root of every one of
the twelve independently specified retained radicands. -/
theorem retainedField_contains_radical (j : Fin 12) :
    ∃ x : RetainedField, x^2 = algebraMap GenusField RetainedField (retainedRadicand j) := by
  obtain ⟨x,hx⟩ := fullRetainedTower.toActualGaloisTower.toActualTower.isSquare_radical j
    (Finset.mem_univ j) (retainedRadicand_ne_zero j)
  exact ⟨x,by simpa [pow_two] using hx.symm⟩

/-- The actual field is generated over the actual genus field by the
square roots of precisely the twelve retained radicands. -/
theorem retainedField_generated :
    Algebra.adjoin GenusField (radicalSet (L := RetainedField) retainedRadicand Finset.univ) = ⊤ :=
  fullRetainedTower.generated

end UnitDistance.ArithmeticRetained
