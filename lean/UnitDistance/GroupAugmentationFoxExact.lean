module

public import UnitDistance.GroupAugmentationFoxDerivative
public import Mathlib.LinearAlgebra.Finsupp.LinearCombination

@[expose] public section
set_option backward.privateInPublic true


/-!
# Exactness of the actual finite-generator Fox sequence

For any group generated by the displayed generators, the actual kernel of
the augmentation generator map is spanned by evaluated derivatives of
actual kernel words in the free group. A section of word evaluation gives
an explicit contraction and proves exactness on elementary coefficients.
-/

noncomputable section
open scoped BigOperators
namespace UnitDistance.GroupAugmentation
variable (R G : Type*) [CommRing R] [Group G]
variable {ι : Type*} [Fintype ι]
local instance : DecidableEq ι := Classical.decEq ι
variable (generators : ι → G)
variable (s : G → FreeGroup ι) (hs : ∀ g, FreeGroup.lift generators (s g) = g)

/-- Linear extension of derivatives of a chosen actual word section. -/
def foxSection : A R G →ₗ[R] (ι → A R G) :=
  (Finsupp.linearCombination R (fun g => foxDerivative R G generators (s g))).comp
    (MonoidAlgebra.coeffLinearEquiv R).toLinearMap

@[simp] theorem foxSection_delta (g : G) :
    foxSection R G generators s (delta R g) = foxDerivative R G generators (s g) := by
  simp [foxSection,delta]

/-- The elementary loop associated to an edge of the actual Cayley graph. -/
def foxLoop (g : G) (i : ι) : FreeGroup ι :=
  s g * FreeGroup.of i * (s (g * generators i))⁻¹

include hs in
theorem foxLoop_eval (g : G) (i : ι) :
    FreeGroup.lift generators (foxLoop G generators s g i) = 1 := by
  simp [foxLoop,hs]

include hs in
/-- The evaluated loop derivative is the elementary coefficient corrected
by the actual word-section boundaries. -/
theorem foxLoop_derivative (g : G) (i : ι) :
    foxDerivative R G generators (foxLoop G generators s g i) =
      Pi.single i (delta R g) -
        foxSection R G generators s (delta R g * (delta R (generators i)-1)) := by
  funext j
  have hsingle : delta R g * (Pi.single i (1 : A R G) : ι → A R G) j =
      (Pi.single i (delta R g) : ι → A R G) j := by
    by_cases h : j = i <;> simp [Pi.single_apply,h]
  simp only [foxLoop,foxDerivative_mul,foxDerivative_inv,foxDerivative_of,
    map_mul,FreeGroup.lift_apply_of,hs]
  rw [hsingle]
  have hprod : delta R g * (delta R (generators i)-1) = delta R (g*generators i)-delta R g := by
    simp [mul_sub]
  rw [hprod,map_sub,foxSection_delta,foxSection_delta]
  simp only [Pi.sub_apply,← delta_mul,mul_neg,← mul_assoc]
  simp
  abel

/-- The section correction fixes every vector in the actual Fox kernel. -/
def foxContraction : (ι → A R G) →ₗ[R] (ι → A R G) :=
  LinearMap.id - (foxSection R G generators s).comp (foxMap R G generators)

@[simp] theorem foxMap_single (i : ι) (a : A R G) :
    foxMap R G generators (Pi.single i a) = a * (delta R (generators i)-1) := by
  simp [foxMap,Pi.single_apply]

include hs in
theorem foxContraction_single_delta (g : G) (i : ι) :
    foxContraction R G generators s (Pi.single i (delta R g)) =
      foxDerivative R G generators (foxLoop G generators s g i) := by
  rw [foxLoop_derivative R G generators s hs]
  simp [foxContraction]

include hs in
/-- Any actual subspace containing derivatives of all kernel words contains
the full actual augmentation-map kernel. This is the substantive Fox
exactness direction. -/
theorem foxKernel_le_of_derivatives
    (M : Submodule R (ι → A R G))
    (hM : ∀ w : FreeGroup ι, FreeGroup.lift generators w = 1 →
      foxDerivative R G generators w ∈ M) :
    (foxMap R G generators).ker ≤ M := by
  have he (i : ι) (a : A R G) :
      foxContraction R G generators s (Pi.single i a) ∈ M := by
    let L := (foxContraction R G generators s).comp (LinearMap.single R (fun _ : ι => A R G) i)
    change L a ∈ M
    induction a using MonoidAlgebra.induction_linear with
    | zero => simp
    | add a b ha hb => simpa only [map_add] using M.add_mem ha hb
    | single g r =>
      have hg : L (delta R g) ∈ M := by
        change foxContraction R G generators s (Pi.single i (delta R g)) ∈ M
        rw [foxContraction_single_delta R G generators s hs]
        exact hM _ (foxLoop_eval G generators s hs g i)
      have hr : MonoidAlgebra.single g r = r • delta R g := by simp [delta]
      rw [hr,map_smul]
      exact M.smul_mem r hg
  intro a ha
  have hsum : foxContraction R G generators s a ∈ M := by
    rw [← LinearMap.sum_single_apply (fun _ : ι => A R G) a,map_sum]
    exact M.sum_mem (fun i _ => he i (a i))
  simpa [foxContraction,(LinearMap.mem_ker.mp ha)] using hsum

/-- The actual Fox-kernel space is the span of actual evaluated kernel-word
derivatives, for every group generated by the displayed finite family. -/
theorem foxKernel_eq_span_derivatives
    (hgen : Subgroup.closure (Set.range generators) = ⊤) :
    (foxMap R G generators).ker =
      Submodule.span R {v | ∃ w : FreeGroup ι,
        FreeGroup.lift generators w = 1 ∧ v = foxDerivative R G generators w} := by
  have hsurj : Function.Surjective (FreeGroup.lift generators) := by
    apply MonoidHom.range_eq_top.mp
    rw [FreeGroup.range_lift_eq_closure,hgen]
  choose s hs using hsurj
  apply le_antisymm
  · apply foxKernel_le_of_derivatives R G generators s hs
    intro w hw
    exact Submodule.subset_span ⟨w,hw,rfl⟩
  · apply Submodule.span_le.mpr
    rintro v ⟨w,hw,rfl⟩
    exact foxDerivative_mem_ker R G generators w hw

end UnitDistance.GroupAugmentation
