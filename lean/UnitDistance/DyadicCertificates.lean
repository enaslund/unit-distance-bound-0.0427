module

public import UnitDistance.DyadicFiltration

@[expose] public section
set_option backward.privateInPublic true


/-! Exact row certificates generated by scripts/generate-dyadic-certificates.py.
The dimensions refer to the concrete coefficient-action recurrence in DyadicFiltration.
All finite identities use kernel-reduced `decide`, never native_decide. -/

set_option maxRecDepth 100000
set_option maxHeartbeats 8000000

open scoped BigOperators
namespace UnitDistance.Dyadic.Filtration

def b0 : Fin 32 → V := fun i => Pi.single i 1

theorem stage_zero_eq : stage 0 = spanRows b0 := by
  apply le_antisymm
  · intro v _
    have hv : v = ∑ i : Fin 32, v i • b0 i := by
      ext j
      simp [b0, Pi.single_apply]
    rw [hv]
    exact sum_mem_spanRows b0 _
  · exact le_top

