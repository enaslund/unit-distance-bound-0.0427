theorem pivots1_correct : ∀ i j, b1 i (pivots1 j) =
    if i = j then 1 else 0 := by decide +kernel

theorem upper1_correct : ∀ i k, step k (b0 i) =
    ∑ j, step k (b0 i) (pivots1 j) • b1 j := by
  intro i k
  fin_cases i <;> fin_cases k <;> decide +kernel

theorem lower1_correct : ∀ j, b1 j =
    ∑ ik : Fin 32 × Fin 3,
      (if (lowerMasks1 j).testBit (3 * ik.1.val + ik.2.val) then (1 : F) else 0)
        • step ik.2 (b0 ik.1) := by
  intro j
  fin_cases j <;> decide +kernel

theorem stage_1_eq : stage 1 = spanRows b1 := by
  rw [show stage 1 = next (stage 0) from rfl, stage_zero_eq]
  exact next_spanRows _ _ _ _
    upper1_correct lower1_correct

theorem finrank_stage_1 : Module.finrank F (stage 1) = 31 := by
  rw [stage_1_eq]
  exact finrank_spanRows b1 pivots1 pivots1_correct

