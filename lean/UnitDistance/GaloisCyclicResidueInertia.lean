module

public import Mathlib.FieldTheory.Galois.Basic

@[expose] public section
set_option backward.privateInPublic true


/-! A quadratic radical of odd valuation cannot be fixed by inertia when
the residue quotient is generated by Frobenius. The proof uses actual
Galois fixed elements and two nonsquare tests over the base field. -/
noncomputable section
namespace UnitDistance.OddTame

variable {K L A : Type*} [Field K] [Field L] [Algebra K L]
  [FiniteDimensional K L] [IsGalois K L] [Group A]

theorem fixed_of_kernel_and_cyclic_lift
    (r : Gal(L/K) →* A) (φ : Gal(L/K))
    (hgen : ∀ σ, ∃ n : ℕ, r σ=(r φ)^n)
    (x : L) (hI : ∀ σ∈r.ker, σ x=x) (hφ : φ x=x) :
    ∀ σ : Gal(L/K), σ x=x := by
  have hpow (n : ℕ) : (φ^n) x=x := by
    induction n with
    | zero => rfl
    | succ n ih => rw [pow_succ, AlgEquiv.mul_apply, hφ, ih]
  intro σ
  obtain ⟨n,hn⟩ := hgen σ
  have hker : σ*(φ^n)⁻¹∈r.ker := by
    simp only [MonoidHom.mem_ker, map_mul, map_inv, map_pow, hn, mul_inv_cancel]
  calc
    σ x = (σ*(φ^n)⁻¹) ((φ^n) x) := by
      change σ x=σ ((φ^n).symm ((φ^n) x))
      rw [AlgEquiv.symm_apply_apply]
    _ = x := by rw [hpow, hI _ hker]

/-- A nonsquare radical cannot have trivial inertia character when multiplying
its radicand by the specified unramified quadratic radicand remains nonsquare. -/
theorem exists_inertia_neg_radical
    (r : Gal(L/K) →* A) (φ : Gal(L/K))
    (hgen : ∀ σ, ∃ n : ℕ, r σ=(r φ)^n)
    (a b : L) (c d : K) (ha : a^2=algebraMap K L c)
    (hb : b^2=algebraMap K L d)
    (hc : ¬IsSquare c) (hcd : ¬IsSquare (c*d))
    (hbI : ∀ σ∈r.ker, σ b=b) (hbφ : φ b= -b) :
    ∃ σ : Gal(L/K), σ∈r.ker ∧ σ a= -a := by
  classical
  by_contra! hnone
  have haI : ∀ σ∈r.ker, σ a=a := by
    intro σ hσ
    have hs : (σ a)^2=a^2 := by rw [← map_pow, ha, σ.commutes]
    exact (sq_eq_sq_iff_eq_or_eq_neg.mp hs).resolve_right (hnone σ hσ)
  have hsφ : (φ a)^2=a^2 := by rw [← map_pow, ha, φ.commutes]
  rcases sq_eq_sq_iff_eq_or_eq_neg.mp hsφ with hφ | hφ
  · have hfixed := fixed_of_kernel_and_cyclic_lift r φ hgen a haI hφ
    obtain ⟨z,hz⟩ := (IsGalois.mem_range_algebraMap_iff_fixed a).mpr hfixed
    apply hc
    refine ⟨z, ?_⟩
    apply (algebraMap K L).injective
    rw [map_mul, hz, ← pow_two, ha]
  · have hfixed := fixed_of_kernel_and_cyclic_lift r φ hgen (a*b)
      (fun σ hσ ↦ by rw [map_mul,haI σ hσ,hbI σ hσ])
      (by rw [map_mul,hφ,hbφ,neg_mul_neg])
    obtain ⟨z,hz⟩ := (IsGalois.mem_range_algebraMap_iff_fixed (a*b)).mpr hfixed
    apply hcd
    refine ⟨z, ?_⟩
    apply (algebraMap K L).injective
    simp only [map_mul, hz]
    rw [← pow_two, mul_pow, ha, hb]

end UnitDistance.OddTame
