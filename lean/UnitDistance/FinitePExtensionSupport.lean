/-
Adapted from Naganori Yamaguchi's SawinTotallyRealTowers, commit
3a455e1aa9140dbbe7b7d68f508392a69c86d0f4 (Apache-2.0).
This new development removes the condition at infinite places; all finite
unramifiedness and actual Galois/p-group conditions are retained.
-/
module

public import UnitDistance.FinitePExtension
public import Mathlib.FieldTheory.IntermediateField.Adjoin.Algebra

@[expose] public section
set_option backward.privateInPublic true


set_option autoImplicit false

/-!
# Finite support in the pro-p tower

Compact intermediate fields contained in the supremum of admissible finite
layers lie in one layer, since the family is nonempty and directed. This
applies both to finite-dimensional intermediate fields and to the field
generated by finitely many elements.
-/

open scoped NumberField
open NumberField IsDedekindDomain

noncomputable section

namespace UnitDistance.ArithmeticProP

open ClassFieldTower.Sawin

/-- Bounded extraction of the generic compactness lemma from upstream
`MaximalEverywhereUnramifiedProPFiniteSupport`, without its arithmetic imports. -/
private theorem finiteDimensional_intermediateField_isCompactElement
    {F E : Type*} [Field F] [Field E] [Algebra F E]
    (L : IntermediateField F E) [FiniteDimensional F L] : IsCompactElement L := by
  have hEss : Algebra.EssFiniteType F L := inferInstance
  obtain ⟨s, hs⟩ := IntermediateField.essFiniteType_iff.mp hEss
  rw [← hs]
  exact IntermediateField.adjoin_finset_isCompactElement s

private theorem compact_le_iSup_pExtension_exists_extension
    (p : ℕ) (T : Set (HeightOneSpectrum (𝓞 ℚ)))
    (L : IntermediateField ℚ (AlgebraicClosure ℚ))
    (hCompact : IsCompactElement L)
    (hL : L ≤ ⨆ E : FinitePExtension p T, E.val.toIntermediateField) :
    ∃ C : FinitePExtension p T, L ≤ C.val.toIntermediateField := by
  let f : FinitePExtension p T → IntermediateField ℚ (AlgebraicClosure ℚ) :=
    fun E ↦ E.val.toIntermediateField
  have hNonempty : (Set.range f).Nonempty :=
    ⟨f (FinitePExtension.bot p T), ⟨FinitePExtension.bot p T, rfl⟩⟩
  have hDirected : DirectedOn (· ≤ ·) (Set.range f) :=
    (FinitePExtension.directed p T).directedOn_range
  have hLe : L ≤ sSup (Set.range f) := by
    simpa only [sSup_range] using hL
  obtain ⟨M, hM, hLM⟩ :=
    (isCompactElement_iff_le_of_directed_sSup_le L).mp hCompact
        (Set.range f) hNonempty hDirected hLe
  rcases hM with ⟨C, rfl⟩
  exact ⟨C, hLM⟩

/-- A finite-dimensional intermediate field in the supremum of admissible
finite layers is contained in one admissible finite layer. -/
theorem finiteDimensional_le_iSup_pExtension_exists_extension
    (p : ℕ) (T : Set (HeightOneSpectrum (𝓞 ℚ)))
    (L : IntermediateField ℚ (AlgebraicClosure ℚ)) [FiniteDimensional ℚ L]
    (hL : L ≤ ⨆ E : FinitePExtension p T, E.val.toIntermediateField) :
    ∃ C : FinitePExtension p T, L ≤ C.val.toIntermediateField := by
  exact compact_le_iSup_pExtension_exists_extension p T L
    (finiteDimensional_intermediateField_isCompactElement L) hL

/-- Finitely many elements of the supremum all belong to a single admissible
finite layer. -/
theorem finset_subset_iSup_pExtension_exists_extension
    (p : ℕ) (T : Set (HeightOneSpectrum (𝓞 ℚ)))
    (s : Finset (AlgebraicClosure ℚ))
    (hs : ∀ x ∈ s, x ∈ ⨆ E : FinitePExtension p T, E.val.toIntermediateField) :
    ∃ C : FinitePExtension p T, ∀ x ∈ s, x ∈ C.val.toIntermediateField := by
  have hAdjoin : IntermediateField.adjoin ℚ (s : Set (AlgebraicClosure ℚ)) ≤
      ⨆ E : FinitePExtension p T, E.val.toIntermediateField :=
    IntermediateField.adjoin_le_iff.mpr (by
      intro x hx
      exact hs x hx)
  obtain ⟨C, hC⟩ := compact_le_iSup_pExtension_exists_extension p T
    (IntermediateField.adjoin ℚ (s : Set (AlgebraicClosure ℚ)))
    (IntermediateField.adjoin_finset_isCompactElement (F := ℚ) s) hAdjoin
  refine ⟨C, ?_⟩
  intro x hx
  exact hC (IntermediateField.subset_adjoin ℚ (s : Set (AlgebraicClosure ℚ)) hx)

end UnitDistance.ArithmeticProP
